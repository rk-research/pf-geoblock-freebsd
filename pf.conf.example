#
# pf.conf.example - table declarations and blocking rules that go with
#                   update-pf-geoblock.sh
#
# Copyright (c) 2026, Richard Knuchel
# Licensed under the BSD 2-Clause License. See LICENSE in the project root.
#
# Merge the marked parts into your existing /etc/pf.conf.  The updater script
# NEVER edits pf.conf; it only rewrites the two referenced files and replaces
# the contents of the two tables shown here.
#
# Requirements the updater relies on:
#   * both tables must already be declared (it refuses to create them, because
#     a table that exists without a matching block rule silently blocks
#     nothing);
#   * the table names must match PF_TABLE_V4 / PF_TABLE_V6 in the script;
#   * the file paths must match IPV4_TARGET / IPV6_TARGET in the script.
#

# --- interfaces / macros -----------------------------------------------------
ext_if = "vtnet0"		# adjust to your NIC

# --- geo-blocking tables -----------------------------------------------------
#
# "persist" keeps a table in the kernel even while no rule references it, so
# "pfctl -T replace" always has a table to write to.  "file" preloads the
# current contents whenever the ruleset is loaded, which means the blocklist
# also survives a reboot or a "pfctl -f /etc/pf.conf" without waiting for the
# next cron run.  The files must exist before the ruleset is loaded, otherwise
# the load fails - create them empty once (see the installation notes).
#
# IPv4 and IPv6 are kept in separate tables and separate files on purpose: a
# PF table can hold both families, but separating them makes the "inet" and
# "inet6" rules below unambiguous and makes a mix-up impossible.
table <geo_block_v4> persist file "/etc/pf.IPv4_geo_block"
table <geo_block_v6> persist file "/etc/pf.IPv6_geo_block"

# --- ruleset -----------------------------------------------------------------
set skip on lo0

scrub in all

# Default deny, then allow what you need (shown for context only).
block return all

# Geo-blocking.  "quick" stops rule evaluation at the first match, so blocked
# networks never reach the more expensive rules below, and placing these rules
# early means no later "pass" rule can accidentally let the traffic through.
block in quick inet  from <geo_block_v4> to any
block in quick inet6 from <geo_block_v6> to any

# Example of the rest of a ruleset (adapt or remove).
pass out all keep state
pass in on $ext_if proto tcp to ($ext_if) port { 22 80 443 } keep state
pass in inet  proto icmp   all icmp-type echoreq keep state
pass in inet6 proto icmp6  all
